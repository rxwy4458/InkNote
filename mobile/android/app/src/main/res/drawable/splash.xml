<?xml version="1.0" encoding="utf-8"?>
<!-- Start-up screen on Android 7 to 11 (Android 12 and later draw it from the theme's windowSplashScreen* items). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item android:width="144dp" android:height="144dp" android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="fill" />
    </item>
</layer-list>
